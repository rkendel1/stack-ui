{
  "name": "stack-ui",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:browser": "node --test --test-concurrency=1 tests/browser/*.test.mjs",
    "check:boundary": "node scripts/check-boundary.mjs",
    "check:citations": "node scripts/check-citations.mjs",
    "test": "pnpm build && pnpm check:boundary && pnpm check:types && pnpm test:unit && pnpm test:browser",
    "check:types": "tsc -p tests/types/tsconfig.json"
  },
  "devDependencies": {
    "@stack-ui/core": "workspace:*",
    "@stack-ui/react": "workspace:*",
    "@types/react": "19.2.0",
    "axe-core": "4.10.3",
    "playwright-core": "1.56.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "5.6.3"
  }
}
