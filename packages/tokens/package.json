{
  "name": "@stack-ui/tokens",
  "version": "0.9.0",
  "description": "Boundry design-foundation tokens (Stack UI) as CSS custom properties (light and dark, or light only), JSON, company and product identity, and the Boundry mark.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./tokens.css": "./css/tokens.css",
    "./tokens-light.css": "./css/tokens-light.css",
    "./tokens.json": "./src/tokens.json",
    "./brand.json": "./src/brand.json",
    "./brand/*": "./brand/*"
  },
  "files": [
    "css",
    "src",
    "brand"
  ],
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
